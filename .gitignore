# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
*~

# Office lock files
~$*

# Source publications held locally for extraction.
# NOT redistributed: most are under publisher copyright. Obtain them from the
# publisher or from the DOI recorded in database/sources.csv.
docs/*.pdf
docs/*.jpg
docs/*.jpeg
docs/*.png
docs/*.tiff

# Append-only run history: guaranteed merge conflicts, no value to a reader.
logs/

# Byte-identical copy of database/rdorp.sqlite, which is tracked.
exports/sqlite/

# Source extracts saved for reading. Museum and database records; not redistributed.
docs/*.txt
docs/sources/*.*
database/*.db
