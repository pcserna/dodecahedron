  },
  {
    "ev_id": "EV045",
    "variable": "Manufacturing difficulty",
    "category": "Manufacturing",
    "definition": "How hard the object actually was to produce: the failure rate of lost-wax casting at this geometry, the skill demanded, and the presence or absence of moulds, casting waste, rejects or workshop debris anywhere in the record",
