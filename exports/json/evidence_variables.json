    "discriminatory_power": "Very High",
    "most_relevant_hypotheses": "H003;H008;C-16"
  },
  {
    "ev_id": "EV046",
    "variable": "Marked axis",
    "category": "Geometry",
    "definition": "Whether the object carries a visual marking that singles out one axis or one face, as distinct from a structural feature such as a base or suspension loop. Distinct from EV038, which asks whether the FUNCTION requires a fixed orientation, and from EV014, which records the presence of decoration",
